{
  "name": "fixt-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "login": "tsx scripts/login.ts",
    "format": "prettier --write src scripts test",
    "format:check": "prettier --check src scripts test",
    "doctor": "tsx scripts/doctor.ts",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts"
  },
  "dependencies": {
    "@openai/codex": "0.159.2",
    "exceljs": "4.4.0",
    "js-tiktoken": "1.0.21",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "pg": "8.23.1",
    "telegramify-markdown": "1.3.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.28.6"
}
