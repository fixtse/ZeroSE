# Pin a sha-<full Git commit> tag or @sha256 digest for controlled releases.
ASSISTANT_IMAGE=ghcr.io/fixtse/node-assistant:latest
ASSISTANT_CONFIG_FILE=./config.json
ASSISTANT_DATA_DIR=./data
# The existing logged-in Codex directory; defaults to $HOME/.codex.
# ASSISTANT_CODEX_HOME=/home/fixt/.codex

# Generate a private hex password before first PostgreSQL startup (openssl rand -hex 32).
ASSISTANT_POSTGRES_PASSWORD=replace-with-a-random-hex-password
ASSISTANT_POSTGRES_PORT=55432

# Optional stable encryption key for credentials entered in /admin (at least 16 characters).
# Set before saving credentials; keep it unchanged across administrator API key rotations.
# Without it, config.apiKey is also used to derive the encryption key.
# ASSISTANT_SECRETS_KEY=

# Optional proxy to the host deployment webhook service (the secret stays on the host).
# ASSISTANT_DEPLOY_WEBHOOK_URL=http://127.0.0.1:8790/github/deploy

# Public origin for administrator login, trusted origins and secure session cookies.
ASSISTANT_ADMIN_URL=https://twk.kcta.cc
